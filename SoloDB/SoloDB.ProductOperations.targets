<Project>
  <PropertyGroup>
    <ProvideCommandLineArgs>true</ProvideCommandLineArgs>
    <_SoloDBProductTools>$(MSBuildThisFileDirectory)../SoloDB.Metadata.Tools/bin/$(Configuration)/netstandard2.0/SoloDB.Metadata.Tools.dll</_SoloDBProductTools>
  </PropertyGroup>
  <UsingTask TaskName="SoloDatabase.Metadata.Tools.ProductOperationDependencies" AssemblyFile="$(_SoloDBProductTools)" />
  <UsingTask TaskName="SoloDatabase.Metadata.Tools.ProductOperationInputs" AssemblyFile="$(_SoloDBProductTools)" />
  <UsingTask TaskName="SoloDatabase.Metadata.Tools.CompleteProductOperations" AssemblyFile="$(_SoloDBProductTools)" />
  <Target Name="SoloDBProductPaths">
    <PropertyGroup>
      <_SoloDBProductRoot>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'SoloDB.Product'))</_SoloDBProductRoot>
      <_SoloDBProductInputs>$(_SoloDBProductRoot)/inputs.xml</_SoloDBProductInputs>
      <_SoloDBProductSelection>$(_SoloDBProductRoot)/selection.xml</_SoloDBProductSelection>
      <_SoloDBProductStamp>$(_SoloDBProductRoot)/completion.stamp</_SoloDBProductStamp>
    </PropertyGroup>
  </Target>
  <Target Name="SoloDBProductCompilerDependencies" BeforeTargets="CoreCompile" DependsOnTargets="SoloDBProductPaths"
          Condition="'$(TargetFramework)' != '' and '$(NoBuild)' != 'true' and '$(DesignTimeBuild)' != 'true' and '$(SkipCompilerExecution)' != 'true' and '$(ProduceOnlyReferenceAssembly)' != 'true'">
    <ProductOperationDependencies InputFile="$(_SoloDBProductInputs)" WorkingDirectory="$(MSBuildProjectDirectory)">
      <Output TaskParameter="Dependencies" ItemName="_SoloDBProductPreviousDependencies" />
    </ProductOperationDependencies>
    <ItemGroup>
      <CustomAdditionalCompileInputs Include="@(_SoloDBProductPreviousDependencies)" />
      <_SoloDBProductCompilerInput Include="@(IntermediateAssembly)" />
    </ItemGroup>
  </Target>
  <Target Name="SoloDBProductInputs" DependsOnTargets="SoloDBProductPaths">
    <ItemGroup>
      <_SoloDBProductImplementation Include="$([System.IO.Path]::GetDirectoryName('$(_SoloDBProductTools)'))/*.dll;$([System.IO.Path]::GetDirectoryName('$(_SoloDBProductTools)'))/*.json" />
    </ItemGroup>
    <ProductOperationInputs InputFile="$(_SoloDBProductInputs)" Stamp="$(_SoloDBProductStamp)" Selection="$(_SoloDBProductSelection)"
        Input="@(_SoloDBProductCompilerInput)" CompilerSymbolFile="@(_DebugSymbolsIntermediatePath)" OutputDirectory="$(_SoloDBProductRoot)/implementation" WorkingDirectory="$(MSBuildProjectDirectory)"
        Arguments="@(FscCommandLineArgs)" References="@(ReferencePathWithRefAssemblies)" ImplementationInputs="@(_SoloDBProductImplementation)">
      <Output TaskParameter="Dependencies" ItemName="_SoloDBProductDependencies" />
      <Output TaskParameter="Assembly" PropertyName="_SoloDBProductAssembly" />
      <Output TaskParameter="Symbols" PropertyName="_SoloDBProductSymbols" />
      <Output TaskParameter="CompilerSymbols" PropertyName="_SoloDBProductCompilerSymbols" />
    </ProductOperationInputs>
  </Target>
  <Target Name="SoloDBProductWork" DependsOnTargets="SoloDBProductInputs"
          Inputs="$(_SoloDBProductInputs);@(_SoloDBProductCompilerInput);@(_SoloDBProductDependencies);@(_SoloDBProductImplementation);$(_SoloDBProductCompilerSymbols);@(ReferencePathWithRefAssemblies);$(MSBuildProjectFullPath);$(MSBuildAllProjects)"
          Outputs="$(_SoloDBProductStamp)">
    <Delete Files="$(_SoloDBProductStamp)" />
    <CompleteProductOperations Input="@(_SoloDBProductCompilerInput)" InputFile="$(_SoloDBProductInputs)"
        OutputDirectory="$(_SoloDBProductRoot)/implementation" Selection="$(_SoloDBProductSelection)" References="@(ReferencePathWithRefAssemblies)">
      <Output TaskParameter="Assembly" PropertyName="_SoloDBProductAssembly" />
      <Output TaskParameter="Symbols" PropertyName="_SoloDBProductSymbols" />
      <Output TaskParameter="CompilerSymbols" PropertyName="_SoloDBProductCompilerSymbols" />
    </CompleteProductOperations>
    <Touch Files="$(_SoloDBProductStamp)" AlwaysCreate="true" />
  </Target>
  <Target Name="SoloDBCompleteProductOperations" AfterTargets="CoreCompile"
          BeforeTargets="GenerateBuildDependencyFile;CopyFilesToOutputDirectory;ComputeResolvedFilesToPublishList"
          DependsOnTargets="SoloDBProductWork"
          Condition="'$(TargetFramework)' != '' and '$(NoBuild)' != 'true' and '$(DesignTimeBuild)' != 'true' and '$(SkipCompilerExecution)' != 'true' and '$(ProduceOnlyReferenceAssembly)' != 'true'">
    <Error Condition="'$(_SoloDBProductAssembly)' == '' or !Exists('$(_SoloDBProductAssembly)')" Text="The completed product implementation was not delivered." />
    <ItemGroup>
      <FileWrites Include="@(_SoloDBProductCompilerInput);$(_SoloDBProductCompilerSymbols);$(_SoloDBProductAssembly);$(_SoloDBProductSymbols);$(_SoloDBProductInputs);$(_SoloDBProductSelection);$(_SoloDBProductStamp)" />
      <IntermediateAssembly Remove="@(IntermediateAssembly)" />
      <IntermediateAssembly Include="$(_SoloDBProductAssembly)" />
      <_DebugSymbolsIntermediatePath Remove="@(_DebugSymbolsIntermediatePath)" />
      <_DebugSymbolsIntermediatePath Include="$(_SoloDBProductSymbols)" Condition="'$(_SoloDBProductSymbols)' != ''" />
    </ItemGroup>
  </Target>
  <!-- NoBuild consumes an already produced selection; it never builds tooling or
       invokes a compiler. Missing production artifacts require a normal build. -->
  <Target Name="SoloDBSelectProductWithoutBuild" BeforeTargets="BuiltProjectOutputGroup;DebugSymbolsProjectOutputGroup;_GetBuildOutputFilesWithTfm;_GetDebugSymbolsWithTfm;ComputeResolvedFilesToPublishList"
          DependsOnTargets="SoloDBProductPaths" Condition="'$(TargetFramework)' != '' and '$(NoBuild)' == 'true' and '$(DesignTimeBuild)' != 'true' and '$(ProduceOnlyReferenceAssembly)' != 'true'">
    <Error Condition="!Exists('$(_SoloDBProductStamp)') or !Exists('$(_SoloDBProductSelection)')" Text="Build the completed product before selecting outputs without a build." />
    <XmlPeek XmlInputPath="$(_SoloDBProductSelection)" Query="/selection/@assembly"><Output TaskParameter="Result" PropertyName="_SoloDBProductAssembly" /></XmlPeek>
    <XmlPeek XmlInputPath="$(_SoloDBProductSelection)" Query="/selection/@symbols"><Output TaskParameter="Result" PropertyName="_SoloDBProductSymbols" /></XmlPeek>
    <Error Condition="!Exists('$(_SoloDBProductAssembly)') or ('$(_SoloDBProductSymbols)' != '' and !Exists('$(_SoloDBProductSymbols)'))" Text="The completed product or its symbols are missing. Build the product to recover them." />
    <PropertyGroup><_SoloDBProductTargetSymbols>$([System.IO.Path]::ChangeExtension('$(TargetPath)', '.pdb'))</_SoloDBProductTargetSymbols></PropertyGroup>
    <Copy SourceFiles="$(_SoloDBProductAssembly)" DestinationFiles="$(TargetPath)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(_SoloDBProductSymbols)" DestinationFiles="$(_SoloDBProductTargetSymbols)" SkipUnchangedFiles="true" Condition="'$(_SoloDBProductSymbols)' != ''" />
    <Delete Files="$(_SoloDBProductTargetSymbols)" Condition="'$(_SoloDBProductSymbols)' == '' and Exists('$(_SoloDBProductTargetSymbols)')" />
    <ItemGroup>
      <FileWrites Include="@(IntermediateAssembly);@(_DebugSymbolsIntermediatePath)" />
      <IntermediateAssembly Remove="@(IntermediateAssembly)" />
      <IntermediateAssembly Include="$(_SoloDBProductAssembly)" />
      <_DebugSymbolsIntermediatePath Remove="@(_DebugSymbolsIntermediatePath)" />
      <_DebugSymbolsIntermediatePath Include="$(_SoloDBProductSymbols)" Condition="'$(_SoloDBProductSymbols)' != ''" />
    </ItemGroup>
  </Target>
</Project>
