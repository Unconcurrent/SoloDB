  <ItemGroup>
    <PackageReference Include="Portable.System.DateTimeOnly" Version="8.0.1" />
    <PackageReference Include="System.Reflection.Emit.Lightweight" Version="4.7.0" Condition="'$(TargetFramework)' == 'netstandard2.0'" />
    <PackageReference Include="System.Threading.Tasks.Extensions" Version="4.6.3" Condition="'$(TargetFramework)' == 'netstandard2.0'" />
    <PackageReference Include="Snappier" Version="1.3.1" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.11" />
    <!-- The native 2.1.12 package carries SQLite 3.53.3, including the WAL-reset fix.
         Keep this explicit dependency: the 2.1.11 bundle otherwise selects its older engine.
         Managed provider components remain on 2.1.11. -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.12" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0' and '$(NoBuild)' != 'true'">
    <ProjectReference Include="../SoloDB.Metadata.CSharp/SoloDB.Metadata.CSharp.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="../SoloDB.Metadata.FSharp/SoloDB.Metadata.FSharp.fsproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../SoloDB.Metadata.Tools/SoloDB.targets;../SoloDB.Metadata.Tools/SoloDB.Metadata.targets;../SoloDB.Metadata.Tools/SoloDB.FSharp.Context.targets;../SoloDB.Metadata.Tools/SoloDB.NativeMetadata.targets"
          Pack="true" PackagePath="buildTransitive" />
  </ItemGroup>

  <Target Name="SoloDBCollectMetadataTools" BeforeTargets="_GetPackageFiles">
    <ReadLinesFromFile File="../SoloDB.Metadata.FSharp/bin/$(Configuration)/netstandard2.0/SoloDB.FSharp.files">
      <Output TaskParameter="Lines" ItemName="_SoloDBFSharpFile" />
    </ReadLinesFromFile>
    <ItemGroup>
      <None Include="../SoloDB.Metadata.CSharp/bin/$(Configuration)/netstandard2.0/SoloDB.Metadata.CSharp.dll;../SoloDB.Metadata.CSharp/bin/$(Configuration)/netstandard2.0/SoloDB.Metadata.Codecs.dll;../SoloDB.Metadata.CSharp/bin/$(Configuration)/netstandard2.0/FSharp.Core.dll"
            Pack="true" PackagePath="analyzers/dotnet/cs" />
      <None Include="../SoloDB.Metadata.FSharp/bin/$(Configuration)/netstandard2.0/%(_SoloDBFSharpFile.Identity)"
            Pack="true" PackagePath="tools/netstandard2.0/%(_SoloDBFSharpFile.Identity)" />
      <None Include="../SoloDB.Metadata.FSharp/FSharp.TypeProviders.SDK.LICENSE.txt"
            Pack="true" PackagePath="tools/netstandard2.0" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <PackageReference Update="FSharp.Core" Version="8.0.100" />
  </ItemGroup>

</Project>
