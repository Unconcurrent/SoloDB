<Project>
  <PropertyGroup Condition="'$(MSBuildProjectExtension)' == '.csproj'">
    <SoloDBGeneratedHelper>true</SoloDBGeneratedHelper>
    <SoloDBGeneratedHelperIdentity>$(AssemblyName).SoloDB.Generated</SoloDBGeneratedHelperIdentity>
    <SoloDBMetadataToolsPath Condition="'$(SoloDBMetadataToolsPath)' == ''">$(MSBuildThisFileDirectory)../tools/netstandard2.0/SoloDB.Metadata.Tools.dll</SoloDBMetadataToolsPath>
  </PropertyGroup>
  <UsingTask TaskName="SoloDatabase.Metadata.Tools.GenerateHelper" AssemblyFile="$(SoloDBMetadataToolsPath)" />
  <ItemGroup Condition="'$(SoloDBGeneratedHelper)' == 'true'">
    <CompilerVisibleProperty Include="SoloDBGeneratedHelper" />
    <RuntimeHostConfigurationOption Include="SoloDB.Metadata.DynamicDiscovery" Value="false" Trim="true" Condition="'$(PublishAot)' == 'true'" />
  </ItemGroup>
  <Target Name="SoloDBGenerateHelperContract" AfterTargets="ResolveAssemblyReferences" BeforeTargets="CoreCompile" Condition="'$(SoloDBGeneratedHelper)' == 'true'">
    <PropertyGroup>
      <SoloDBGeneratedHelperRoot>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'SoloDB.Generated'))</SoloDBGeneratedHelperRoot>
      <SoloDBGeneratedContract>$(SoloDBGeneratedHelperRoot)/contract/$(SoloDBGeneratedHelperIdentity).dll</SoloDBGeneratedContract>
      <SoloDBGeneratedImplementation>$(SoloDBGeneratedHelperRoot)/implementation/$(SoloDBGeneratedHelperIdentity).dll</SoloDBGeneratedImplementation>
      <_SoloDBGeneratedKeyFile Condition="'$(SignAssembly)' == 'true'">$(AssemblyOriginatorKeyFile)</_SoloDBGeneratedKeyFile>
    </PropertyGroup>
    <SoloDatabase.Metadata.Tools.GenerateHelper Output="$(SoloDBGeneratedContract)" Identity="$(SoloDBGeneratedHelperIdentity)" KeyFile="$(_SoloDBGeneratedKeyFile)" References="@(ReferenceCopyLocalPaths);@(ReferencePath)" />
    <GetAssemblyIdentity AssemblyFiles="$(SoloDBGeneratedContract)">
      <Output TaskParameter="Assemblies" ItemName="_SoloDBGeneratedContractIdentity" />
    </GetAssemblyIdentity>
    <ItemGroup>
      <_SoloDBGeneratedContractReference Include="@(_SoloDBGeneratedContractIdentity->'%(OriginalItemSpec)')">
        <FusionName>%(_SoloDBGeneratedContractIdentity.Identity)</FusionName>
      </_SoloDBGeneratedContractReference>
      <ReferencePath Include="@(_SoloDBGeneratedContractReference)">
        <Aliases>SoloDBGeneratedOperations</Aliases>
      </ReferencePath>
      <ReferencePathWithRefAssemblies Include="@(_SoloDBGeneratedContractReference)">
        <Aliases>SoloDBGeneratedOperations</Aliases>
      </ReferencePathWithRefAssemblies>
      <ReferenceCopyLocalPaths Include="@(_SoloDBGeneratedContractReference)" />
    </ItemGroup>
  </Target>
  <Target Name="SoloDBGenerateHelperImplementation" AfterTargets="CoreCompile" BeforeTargets="GenerateBuildDependencyFile;CopyFilesToOutputDirectory;_ComputeResolvedCopyLocalPublishAssets"
          Condition="'$(SoloDBGeneratedHelper)' == 'true' and '$(DesignTimeBuild)' != 'true'">
    <SoloDatabase.Metadata.Tools.GenerateHelper Consumer="@(IntermediateAssembly)" Output="$(SoloDBGeneratedImplementation)" Identity="$(SoloDBGeneratedHelperIdentity)" KeyFile="$(_SoloDBGeneratedKeyFile)" References="@(ReferenceCopyLocalPaths);@(ReferencePath)">
      <Output TaskParameter="Active" PropertyName="SoloDBGeneratedActive" />
    </SoloDatabase.Metadata.Tools.GenerateHelper>
    <GetAssemblyIdentity AssemblyFiles="$(SoloDBGeneratedImplementation)" Condition="'$(SoloDBGeneratedActive)' == 'true'">
      <Output TaskParameter="Assemblies" ItemName="_SoloDBGeneratedImplementationIdentity" />
    </GetAssemblyIdentity>
    <ItemGroup>
      <_SoloDBGeneratedDependencyInputs Include="@(IntermediateAssembly)" />
      <_SoloDBGeneratedDependencyInputs Include="$(SoloDBGeneratedImplementation)" Condition="'$(SoloDBGeneratedActive)' == 'true'" />
      <_SoloDBGeneratedImplementationReference Include="@(_SoloDBGeneratedImplementationIdentity->'%(OriginalItemSpec)')" Condition="'$(SoloDBGeneratedActive)' == 'true'">
        <FusionName>%(_SoloDBGeneratedImplementationIdentity.Identity)</FusionName>
      </_SoloDBGeneratedImplementationReference>
      <ReferencePath Remove="@(ReferencePath)" Condition="'%(ReferencePath.Filename)' == '$(SoloDBGeneratedHelperIdentity)'" />
      <ReferencePath Include="@(_SoloDBGeneratedImplementationReference)" Condition="'$(SoloDBGeneratedActive)' == 'true'">
        <CopyLocal>true</CopyLocal>
        <IncludeRuntimeDependency>true</IncludeRuntimeDependency>
      </ReferencePath>
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)" Condition="'%(ReferenceCopyLocalPaths.Filename)' == '$(SoloDBGeneratedHelperIdentity)'" />
      <ReferenceCopyLocalPaths Include="@(_SoloDBGeneratedImplementationReference)" Condition="'$(SoloDBGeneratedActive)' == 'true'" />
    </ItemGroup>
    <Delete Files="$(OutDir)$(SoloDBGeneratedHelperIdentity).dll" Condition="'$(SoloDBGeneratedActive)' != 'true'" />
  </Target>
  <Target Name="SoloDBRefreshBuildDependencyFile" BeforeTargets="GenerateBuildDependencyFile"
          DependsOnTargets="SoloDBGenerateHelperImplementation"
          Inputs="@(_SoloDBGeneratedDependencyInputs)" Outputs="$(ProjectDepsFilePath)"
          Condition="'$(SoloDBGeneratedHelper)' == 'true' and '$(DesignTimeBuild)' != 'true' and '$(GenerateDependencyFile)' == 'true' and '$(ProjectDepsFilePath)' != ''">
    <Delete Files="$(ProjectDepsFilePath)" />
  </Target>
  <Target Name="SoloDBRefreshPublishDependencyFile" BeforeTargets="GeneratePublishDependencyFile"
          DependsOnTargets="SoloDBGenerateHelperImplementation;_ComputeIntermediateDepsFilePath"
          Inputs="@(_SoloDBGeneratedDependencyInputs)" Outputs="$(IntermediateDepsFilePath)"
          Condition="'$(SoloDBGeneratedHelper)' == 'true' and '$(DesignTimeBuild)' != 'true' and '$(GenerateDependencyFile)' == 'true' and '$(_UseBuildDependencyFile)' != 'true' and '$(PublishAot)' != 'true'">
    <Delete Files="$(IntermediateDepsFilePath)" />
  </Target>
  <Import Project="$(MSBuildThisFileDirectory)SoloDB.NativeMetadata.targets" />
</Project>
