<Project>
  <UsingTask TaskName="SoloDatabase.Metadata.Tools.PrepareNativeUnionMetadata" AssemblyFile="$(SoloDBMetadataToolsPath)" />
  <Target Name="SoloDBPrepareNativeUnionMetadata" BeforeTargets="WriteIlcRspFileForCompilation"
          Condition="'$(PublishAot)' == 'true' and '$(DesignTimeBuild)' != 'true'">
    <PropertyGroup Condition="'$(_SoloDBCompletionChanged)' == 'true'">
      <_SoloDBCompilerNativeMainPath>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', '$(TargetName)$(TargetExt)'))</_SoloDBCompilerNativeMainPath>
    </PropertyGroup>
    <ItemGroup Condition="'$(_SoloDBCompletionChanged)' == 'true'">
      <!-- Older native SDK targets select the compiler image instead of IntermediateAssembly. -->
      <_SoloDBCompilerNativeMain Include="@(ManagedBinary)" Condition="'%(ManagedBinary.FullPath)' == '$(_SoloDBCompilerNativeMainPath)'" />
      <_SoloDBCompilerNativeInputs Include="@(IlcCompileInput)" Condition="'%(IlcCompileInput.FullPath)' == '$(_SoloDBCompilerNativeMainPath)'" />
      <_SoloDBCompilerNativeReferences Include="@(IlcReference)" Condition="'%(IlcReference.FullPath)' == '$(_SoloDBCompilerNativeMainPath)'" />
      <ManagedBinary Remove="@(_SoloDBCompilerNativeMain)" />
      <ManagedBinary Include="@(_SoloDBCompilerNativeMain->'$(_SoloDBCompletedAssembly)')" />
      <IlcCompileInput Remove="@(_SoloDBCompilerNativeInputs)" />
      <IlcCompileInput Include="@(_SoloDBCompilerNativeInputs->'$(_SoloDBCompletedAssembly)')" />
      <IlcReference Remove="@(_SoloDBCompilerNativeReferences)" />
      <IlcReference Include="@(_SoloDBCompilerNativeReferences->'$(_SoloDBCompletedAssembly)')" />
    </ItemGroup>
    <ItemGroup>
      <_SoloDBOriginalNativeInputs Include="@(ManagedBinary)" />
    </ItemGroup>
    <SoloDatabase.Metadata.Tools.PrepareNativeUnionMetadata References="@(IlcReference)" Inputs="@(ManagedBinary)"
        OutputDirectory="$(IntermediateOutputPath)SoloDB.Generated/native-models">
      <Output TaskParameter="NativeReferences" ItemName="_SoloDBNativeReferences" />
      <Output TaskParameter="NativeInputs" ItemName="_SoloDBNativeInputs" />
    </SoloDatabase.Metadata.Tools.PrepareNativeUnionMetadata>
    <ItemGroup>
      <IlcReference Remove="@(IlcReference)" />
      <IlcReference Include="@(_SoloDBNativeReferences)" />
      <IlcCompileInput Remove="@(_SoloDBOriginalNativeInputs)" />
      <ManagedBinary Remove="@(ManagedBinary)" />
      <ManagedBinary Include="@(_SoloDBNativeInputs)">
        <IlcRspFile>$(NativeIntermediateOutputPath)%(Filename).ilc.rsp</IlcRspFile>
        <IlcOutputFile>$(NativeIntermediateOutputPath)%(Filename)$(IlcOutputFileExt)</IlcOutputFile>
      </ManagedBinary>
      <IlcCompileInput Include="@(_SoloDBNativeInputs)" />
    </ItemGroup>
  </Target>
</Project>
