<Project>
  <PropertyGroup>
    <SoloDBMetadataToolsPath Condition="'$(SoloDBMetadataToolsPath)' == ''">$(MSBuildThisFileDirectory)../tools/netstandard2.0/SoloDB.Metadata.Tools.dll</SoloDBMetadataToolsPath>
    <SoloDBGeneratedHelper>true</SoloDBGeneratedHelper>
    <SoloDBGeneratedHelperIdentity>$(AssemblyName).SoloDB.Generated</SoloDBGeneratedHelperIdentity>
    <_SoloDBHelperImplementationDependsOn>SoloDBCompleteFSharpAssembly</_SoloDBHelperImplementationDependsOn>
    <SoloDBContextMode Condition="'$(SoloDBContextMode)' == ''">check</SoloDBContextMode>
    <SoloDBBuildTiming Condition="'$(SoloDBBuildTiming)' == ''">false</SoloDBBuildTiming>
    <SoloDBFSharpProviderPath Condition="'$(SoloDBFSharpProviderPath)' == ''">$(MSBuildThisFileDirectory)../tools/netstandard2.0/SoloDB.Metadata.FSharp.dll</SoloDBFSharpProviderPath>
    <_SoloDBDotNetHost>$(DotNetHostPath)</_SoloDBDotNetHost>
    <_SoloDBDotNetHost Condition="'$(_SoloDBDotNetHost)' == ''">$(DOTNET_HOST_PATH)</_SoloDBDotNetHost>
    <_SoloDBDotNetHost Condition="'$(_SoloDBDotNetHost)' == '' and '$(NetCoreRoot)' != ''">$(NetCoreRoot)dotnet</_SoloDBDotNetHost>
    <NonExistentFile Condition="'$(DesignTimeBuild)' == 'true' and '$(SkipCompilerExecution)' == 'true' and '$(ProvideCommandLineArgs)' == 'true'">$(IntermediateOutputPath)SoloDB.Generated/command-line-only</NonExistentFile>
  </PropertyGroup>
  <UsingTask TaskName="SoloDatabase.Metadata.Tools.CaptureProjectContext" AssemblyFile="$(SoloDBMetadataToolsPath)" />
  <UsingTask TaskName="SoloDatabase.Metadata.Tools.PrepareFSharpProject" AssemblyFile="$(SoloDBMetadataToolsPath)" />
  <UsingTask TaskName="SoloDatabase.Metadata.Tools.CompleteFSharpAssembly" AssemblyFile="$(SoloDBMetadataToolsPath)" />
  <UsingTask TaskName="SoloDatabase.Metadata.Tools.FSharpPreparationInputs" AssemblyFile="$(SoloDBMetadataToolsPath)" />
  <UsingTask TaskName="SoloDatabase.Metadata.Tools.FSharpCompletionInputs" AssemblyFile="$(SoloDBMetadataToolsPath)" />
  <Target Name="SoloDBFSharpBuildPaths">
    <PropertyGroup>
      <_SoloDBFSharpRoot>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'SoloDB.Generated'))</_SoloDBFSharpRoot>
      <_SoloDBProjectContext>$(_SoloDBFSharpRoot)/SoloDB.ProjectContext.dll</_SoloDBProjectContext>
      <_SoloDBProjectContext Condition="'$(DesignTimeBuild)' == 'true' and '$(SoloDBContextMode)' != 'execute'">$(_SoloDBFSharpRoot)/Surface/SoloDB.ProjectContext.dll</_SoloDBProjectContext>
      <_SoloDBAttributeSource>$(_SoloDBFSharpRoot)/SoloDB.Access.fs</_SoloDBAttributeSource>
      <_SoloDBTemplate>$(_SoloDBFSharpRoot)/SoloDB.Template.dll</_SoloDBTemplate>
      <_SoloDBPreparationInputFile>$(_SoloDBFSharpRoot)/preparation-inputs.xml</_SoloDBPreparationInputFile>
      <_SoloDBPreparationStamp>$(_SoloDBFSharpRoot)/preparation.stamp</_SoloDBPreparationStamp>
      <_SoloDBCompletionInputFile>$(_SoloDBFSharpRoot)/completion-inputs.xml</_SoloDBCompletionInputFile>
      <_SoloDBCompletionStamp>$(_SoloDBFSharpRoot)/completion.stamp</_SoloDBCompletionStamp>
      <_SoloDBCompletionSelection>$(_SoloDBFSharpRoot)/completion.xml</_SoloDBCompletionSelection>
    </PropertyGroup>
    <ItemGroup>
      <_SoloDBFSharpImplementationInputs Include="$(SoloDBMetadataToolsPath);$(SoloDBFSharpProviderPath);$(_SoloDBDotNetHost)" />
      <_SoloDBFSharpImplementationInputs Include="$([System.IO.Path]::GetDirectoryName('$(SoloDBMetadataToolsPath)'))/*.dll;$([System.IO.Path]::GetDirectoryName('$(SoloDBMetadataToolsPath)'))/*.json" />
      <_SoloDBFSharpImplementationInputs Include="$([System.IO.Path]::GetDirectoryName('$(SoloDBFSharpProviderPath)'))/*.dll;$([System.IO.Path]::GetDirectoryName('$(SoloDBFSharpProviderPath)'))/*.json" />
      <_SoloDBFSharpImplementationInputs Include="$([System.IO.Path]::GetDirectoryName('$(SoloDBFSharpProviderPath)'))/analysis/**/*.dll;$([System.IO.Path]::GetDirectoryName('$(SoloDBFSharpProviderPath)'))/analysis/**/*.json" />
    </ItemGroup>
  </Target>
  <Target Name="SoloDBExcludeTerminalInputs" BeforeTargets="CoreCompile" Condition="'$(DesignTimeBuild)' == 'true'">
    <ItemGroup>
      <Compile Remove="$(IntermediateOutputPath)SoloDB.Generated/SoloDB.Access.fs" />
    </ItemGroup>
  </Target>
  <Target Name="SoloDBCaptureProjectContext" AfterTargets="CoreCompile" Returns="@(_SoloDBProjectContextOutput)"
          DependsOnTargets="SoloDBFSharpBuildPaths"
          Condition="'$(DesignTimeBuild)' == 'true' and '$(ProvideCommandLineArgs)' == 'true'">
    <SoloDatabase.Metadata.Tools.CaptureProjectContext
        Output="$(_SoloDBProjectContext)" Project="$(MSBuildProjectFullPath)"
        Mode="check" Arguments="@(FscCommandLineArgs)" />
    <ItemGroup>
      <_SoloDBProjectContextOutput Include="$(_SoloDBProjectContext)">
        <Template>$(_SoloDBActiveTemplate)</Template>
      </_SoloDBProjectContextOutput>
      <FscCommandLineArgs Include="-r:$(_SoloDBProjectContext)" />
    </ItemGroup>
  </Target>
  <Target Name="SoloDBExecutableInputs" DependsOnTargets="Compile;SoloDBCaptureProjectContext" Returns="@(_SoloDBProjectContextOutput)" />
  <Target Name="SoloDBExecutableProjectContext" BeforeTargets="FSharpSourceCodeCompileOrder" DependsOnTargets="SoloDBFSharpBuildPaths" Condition="'$(DesignTimeBuild)' != 'true'">
    <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="SoloDBExecutableInputs"
        Properties="DesignTimeBuild=true;SkipCompilerExecution=true;ProvideCommandLineArgs=true;SoloDBContextMode=execute"
        BuildInParallel="false">
      <Output TaskParameter="TargetOutputs" ItemName="_SoloDBExecutableContext" />
    </MSBuild>
    <Error Condition="'@(_SoloDBExecutableContext)' == ''" Text="The current FSharp compiler context was not delivered." />
    <GetAssemblyIdentity AssemblyFiles="@(_SoloDBExecutableContext)">
      <Output TaskParameter="Assemblies" ItemName="_SoloDBExecutableContextIdentity" />
    </GetAssemblyIdentity>
    <ItemGroup>
      <_SoloDBExecutableContextReference Include="@(_SoloDBExecutableContextIdentity->'%(OriginalItemSpec)')">
        <FusionName>%(_SoloDBExecutableContextIdentity.Identity)</FusionName>
      </_SoloDBExecutableContextReference>
      <ReferencePath Include="@(_SoloDBExecutableContextReference)" />
      <ReferencePathWithRefAssemblies Include="@(_SoloDBExecutableContextReference)" />
      <CustomAdditionalCompileInputs Include="@(_SoloDBExecutableContext->'%(Template)')" />
      <FileWrites Include="@(_SoloDBExecutableContext);@(_SoloDBExecutableContext->'%(Template)')" />
      <FileWrites Include="$(_SoloDBAttributeSource);$(_SoloDBFSharpRoot)/Surface/SoloDB.ProjectContext.dll;$(_SoloDBPreparationInputFile);$(_SoloDBPreparationStamp);$(_SoloDBCompletionInputFile);$(_SoloDBCompletionStamp);$(_SoloDBCompletionSelection)" />
      <Compile Remove="$(IntermediateOutputPath)SoloDB.Generated/SoloDB.Access.fs" />

    </ItemGroup>
  </Target>
  <Target Name="SoloDBFSharpCompletionInputs" DependsOnTargets="SoloDBFSharpBuildPaths;SoloDBHelperBuildPaths"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <_SoloDBCompletionContext>@(_SoloDBExecutableContext)</_SoloDBCompletionContext>
      <_SoloDBCompletionContext Condition="'$(_SoloDBCompletionContext)' == ''">$(IntermediateOutputPath)SoloDB.Generated/SoloDB.ProjectContext.dll</_SoloDBCompletionContext>
    </PropertyGroup>
    <SoloDatabase.Metadata.Tools.FSharpCompletionInputs InputFile="$(_SoloDBCompletionInputFile)" Stamp="$(_SoloDBCompletionStamp)"
        Selection="$(_SoloDBCompletionSelection)" Input="@(IntermediateAssembly)" Context="$(_SoloDBCompletionContext)"
        OutputDirectory="$(_SoloDBFSharpRoot)/consumer" References="@(ReferencePath);@(ReferenceCopyLocalPaths)"
        ImplementationInputs="@(_SoloDBFSharpImplementationInputs)">
      <Output TaskParameter="Template" PropertyName="_SoloDBCompletionTemplate" />
      <Output TaskParameter="SigningKey" PropertyName="_SoloDBCompletionSigningKey" />
      <Output TaskParameter="Dependencies" ItemName="_SoloDBCompletionConsumedInputs" />
      <Output TaskParameter="Assembly" PropertyName="_SoloDBCompletedAssembly" />
      <Output TaskParameter="Symbols" PropertyName="_SoloDBCompletedSymbols" />
      <Output TaskParameter="CompilerSymbols" PropertyName="_SoloDBCompilerSymbols" />
      <Output TaskParameter="Changed" PropertyName="_SoloDBCompletionChanged" />
    </SoloDatabase.Metadata.Tools.FSharpCompletionInputs>
  </Target>
  <Target Name="SoloDBFSharpCompletionWork" DependsOnTargets="SoloDBFSharpCompletionInputs"
          Inputs="$(_SoloDBCompletionInputFile);@(IntermediateAssembly);@(_DebugSymbolsIntermediatePath);$(_SoloDBCompletionContext);$(_SoloDBCompletionTemplate);$(_SoloDBCompletionSigningKey);@(ReferencePath);@(ReferenceCopyLocalPaths);$(MSBuildProjectFullPath);$(MSBuildAllProjects);@(_SoloDBFSharpImplementationInputs);@(_SoloDBCompletionConsumedInputs)"
          Outputs="$(_SoloDBCompletionStamp)" Condition="'$(DesignTimeBuild)' != 'true'">
    <Delete Files="$(_SoloDBCompletionStamp)" />
    <SoloDatabase.Metadata.Tools.PrepareFSharpProject Input="@(IntermediateAssembly)" Context="$(_SoloDBCompletionContext)"
        OutputDirectory="$(_SoloDBFSharpRoot)/consumer" Selection="$(_SoloDBCompletionSelection)" ProfileBuild="$(SoloDBBuildTiming)"
        HelperOutput="$(SoloDBGeneratedImplementation)" Provider="$(SoloDBFSharpProviderPath)" DotNetHost="$(_SoloDBDotNetHost)"
        AssemblyName="$(AssemblyName)" AttributeSource="$(_SoloDBAttributeSource)" Template="$(_SoloDBTemplate)" />
    <Touch Files="$(_SoloDBCompletionStamp)" AlwaysCreate="true" />
  </Target>
  <Target Name="SoloDBCompleteFSharpAssembly" AfterTargets="CoreCompile"
          BeforeTargets="GenerateBuildDependencyFile;CopyFilesToOutputDirectory;ComputeResolvedFilesToPublishList;BuiltProjectOutputGroup;DebugSymbolsProjectOutputGroup"
          DependsOnTargets="SoloDBFSharpCompletionWork"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <SoloDatabase.Metadata.Tools.FSharpCompletionInputs InputFile="$(_SoloDBCompletionInputFile)" Stamp="$(_SoloDBCompletionStamp)"
        Selection="$(_SoloDBCompletionSelection)" Input="@(IntermediateAssembly)" Context="$(_SoloDBCompletionContext)"
        OutputDirectory="$(_SoloDBFSharpRoot)/consumer" ReadSelectionOnly="true">
      <Output TaskParameter="Assembly" PropertyName="_SoloDBCompletedAssembly" />
      <Output TaskParameter="Symbols" PropertyName="_SoloDBCompletedSymbols" />
      <Output TaskParameter="CompilerSymbols" PropertyName="_SoloDBCompilerSymbols" />
      <Output TaskParameter="Changed" PropertyName="_SoloDBCompletionChanged" />
      <Output TaskParameter="Helper" PropertyName="_SoloDBSelectedHelper" />
    </SoloDatabase.Metadata.Tools.FSharpCompletionInputs>
    <PropertyGroup><SoloDBGeneratedActive>false</SoloDBGeneratedActive><SoloDBGeneratedActive Condition="'$(_SoloDBSelectedHelper)' != ''">true</SoloDBGeneratedActive></PropertyGroup>
    <!-- Always restore selection after SDK skips. Changed selects the completed
         image; it does not mean content-aware publication wrote new bytes. -->
    <ItemGroup Condition="'$(_SoloDBCompletionChanged)' == 'true'">
      <!-- SDK stale-output cleanup must retain the compiler artifact used by the next completion. -->
      <FileWrites Include="@(IntermediateAssembly)" />
      <FileWrites Include="$(_SoloDBCompilerSymbols)" Condition="'$(_SoloDBCompilerSymbols)' != ''" />
      <IntermediateAssembly Remove="@(IntermediateAssembly)" />
      <IntermediateAssembly Include="$(_SoloDBCompletedAssembly)" />
      <_DebugSymbolsIntermediatePath Remove="@(_DebugSymbolsIntermediatePath)" />
      <_DebugSymbolsIntermediatePath Include="$(_SoloDBCompletedSymbols)" Condition="'$(_SoloDBCompletedSymbols)' != ''" />
      <FileWrites Include="$(_SoloDBCompletedAssembly)" />
      <FileWrites Include="$(_SoloDBCompletedSymbols)" Condition="'$(_SoloDBCompletedSymbols)' != ''" />
    </ItemGroup>
  </Target>
  <Import Project="$(MSBuildThisFileDirectory)SoloDB.Metadata.targets" />
</Project>
